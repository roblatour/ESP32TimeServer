# Required to build on ESP-IDF v5.5.3+
CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Required to build on ESP-IDF v6.0.2+
CONFIG_LIBC_NEWLIB=y

# ==============================================================================
# COMPILER WARNING CONFIGURATION
# ==============================================================================
# Keep ESP-IDF's -Werror=all policy; the root CMake file selectively relaxes
# optimization-sensitive diagnostics for third-party components only.
# ============================================================================
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# allows up to 64 NTP requests to be serviced concurrently
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ETH_TRANSMIT_MUTEX=y
CONFIG_ETH_DMA_RX_BUFFER_NUM=30
CONFIG_ETH_DMA_TX_BUFFER_NUM=30
CONFIG_ETH_IRAM_OPTIMIZATION=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Compiler optimization for performance (-O2): shorter and steadier NTP and PPS code paths.
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y
