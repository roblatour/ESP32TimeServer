# ESP32-P4 production chips rev v3.1 and later.
# ESP-IDF v5.5 defaults to this minimum revision when no overlay is provided.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP_HOSTED_ENABLED=n
CONFIG_ESP_WIFI_REMOTE_ENABLED=n
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
